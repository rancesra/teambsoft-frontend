# El login (contrato del Host App v1.3, sección 5).
# - VITE_KEYCLOAK_URL: el realm "tienda" de Keycloak, que corre en el docker-compose del backend o en
#   el de integración. Si se borra, el módulo funciona igual, sin login, y la administración queda
#   bloqueada porque el backend la exige.
# - VITE_HOST_APP: la única dirección de la que el módulo acepta la sesión cuando está embebido.
VITE_KEYCLOAK_URL=http://localhost:8180/realms/tienda
VITE_KEYCLOAK_CLIENTE=tienda-web
VITE_HOST_APP=http://localhost:5050
